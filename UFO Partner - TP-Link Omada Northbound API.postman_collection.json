      "item": [
        {
          "name": "Get SSID List",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"HTTP success\", function () { pm.expect(pm.response.code).to.be.oneOf([200,201]); });",
                  "try {",
                  "  const j = pm.response.json();",
                  "  pm.test(\"Omada errorCode is 0\", function () { pm.expect(j.errorCode).to.eql(0); });",
                  "  if (j.result && j.result.length && j.result[0].ssidList && j.result[0].ssidList.length) {",
                  "    pm.collectionVariables.set(\"wlanId\", j.result[0].wlanId || \"\");",
                  "    pm.collectionVariables.set(\"ssidId\", j.result[0].ssidList[0].ssidId || \"\");",
                  "  }",
                  "} catch(e) {}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "content-type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "AccessToken={{accessToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/openapi/v1/{{omadacId}}/sites/{{siteId}}/wireless-network/ssids?type=3",
