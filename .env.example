BACKEND_URL=http://localhost:8080
VITE_BACKEND_BASE_URL=/backend-api
# Configure Omada credentials and site on Spring Boot only; see backend/.env.example.
HTTP_PORT=8080
PUBLIC_ORIGIN=http://localhost:8080
# Use an absolute path on the deployment server if desired (e.g. /srv/ufo/mysql).
MYSQL_DATA_DIR=./data/mysql
DATABASE_PASSWORD=replace-with-a-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-root-password
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-super-admin-password
OMADA_BASE_URL=https://euw1-omada-northbound.tplinkcloud.com
OMADA_CONTROLLER_ID=
OMADA_CLIENT_ID=
OMADA_CLIENT_SECRET=
# Optional default site for a super administrator; partner sites are assigned in Users.
OMADA_SITE_ID=
OMADA_SITE_NAME=UFO Location
# Defaults match the supplied @25 device list and @26 reboot documentation.
OMADA_DEVICES_PATH=/openapi/v1/{omadacId}/sites/{siteId}/devices
OMADA_STATE_FIELD=status
OMADA_CONNECTED_VALUE=1
OMADA_DISCONNECTED_VALUE=0
OMADA_REBOOT_PATH=/openapi/v1/{omadacId}/sites/{siteId}/devices/{deviceMac}/reboot
OMADA_REBOOT_METHOD=POST
NOTIFICATION_DELIVERY_URL=
NOTIFICATION_DELIVERY_TOKEN=
