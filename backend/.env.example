# Optional trusted-machine key for monitoring ingestion; never configure this in React.
MONITORING_API_KEY=
DATABASE_URL=jdbc:mysql://localhost:3306/ufo_portal?connectionTimeZone=UTC
DATABASE_USERNAME=ufo
DATABASE_PASSWORD=replace-with-a-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-root-password
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-admin-password
USER_SESSION_SECONDS=28800
MONITORING_CORS_ORIGIN=http://localhost:5173
MONITORING_TICK_MS=30000
MONITORING_STALE_SECONDS=180
OMADA_BASE_URL=https://euw1-omada-northbound.tplinkcloud.com
OMADA_CONTROLLER_ID=
OMADA_SITE_ID=
OMADA_SITE_NAME=UFO Location
OMADA_CLIENT_ID=
OMADA_CLIENT_SECRET=
# Defaults match the supplied @25/@26 API documentation.
OMADA_DEVICES_PATH=/openapi/v1/{omadacId}/sites/{siteId}/devices
OMADA_STATE_FIELD=status
OMADA_CONNECTED_VALUE=1
OMADA_DISCONNECTED_VALUE=0
OMADA_REBOOT_PATH=/openapi/v1/{omadacId}/sites/{siteId}/devices/{deviceMac}/reboot
OMADA_REBOOT_METHOD=POST
# Your email/SMS delivery service; blank means notifications remain PENDING.
NOTIFICATION_DELIVERY_URL=
NOTIFICATION_DELIVERY_TOKEN=
